# Olá Brasil — environment variables (example)
#
# Copy to `.env` and fill in only what you need. THE APP RUNS WITH NONE OF THESE:
# the AI assistant falls back to the offline Mock provider and speech uses the
# browser's Web Speech API. Never commit a real `.env`.

# --- AI providers (optional) ---
# If set, the OpenAI provider becomes selectable in Settings.
# SECURITY: a key here is exposed to the browser. For production, point
# VITE_OPENAI_BASE_URL at your own serverless proxy that injects the key.
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# Example for a future Anthropic provider (see docs/adding-ai-provider.md)
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Optional cloud sync (disabled by default; app is offline-first) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
